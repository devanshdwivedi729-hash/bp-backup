            timezone: [VALIDATION_TYPE_REQUIRED]
        }

        const oneTimeContinousValidations = {
            start_date: [VALIDATION_TYPE_REQUIRED],
            start_time: [VALIDATION_TYPE_REQUIRED],
            end_date: [VALIDATION_TYPE_REQUIRED],
            end_time: [VALIDATION_TYPE_REQUIRED],
