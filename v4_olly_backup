import { Box } from '@mui/material'
import React, { useRef, useState,useEffect } from 'react'
import { useSearchParams } from "react-router-dom";

import { Input } from '../../../components/genericComponents/Input'
import { getCommonFunctions } from '../../serviceRevamp/add/ci_flow/SourceDetails';

const InputBubble = ({onSend, ...props}) => {
    const [state, setState] = useState({
        data: {},
        error: {}
    });
    const commonFunction = getCommonFunctions(state, setState, {});
    const inputRef = useRef(null);
     const [searchParams] = useSearchParams();


const autoPrompt = searchParams.get("prompt");
const autoSend = searchParams.get("auto_send");
    
    useEffect(() => {
      if (autoPrompt) {
            try {
              onSend(autoPrompt);
            } catch (e) {
              /* ignore */
            }
         
    
      }
    }, [autoPrompt]);

    const handleBoxClick = () => {
        if (inputRef.current) {
            inputRef.current.focus();
        }
    };

     const handleKeyDown = (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            send();
        }
    };      
    const send = () => {
        let text = state.data.chat_entry;
        const trimmed = text.trim();
        if (!trimmed) return;
        if (typeof onSend === 'function') {
            // allow onSend to be async

            try { onSend(trimmed); } catch (e) { /* ignore */ }
        }
        setState(prev => ({ ...prev, data: { ...prev.data, chat_entry: '' } }));
    };


    return (
        <Box
            className="d-flex align-center"
            sx={{
                backgroundColor: '#fff',
                border: '1px solid #cacaca',
                padding: '8px',
                borderRadius: '50px',
                '& .input-component': {
                    marginBottom: '0px',
                    '& input': {
                        border: "none",
                        outline: 'none',
                        '&:focus': {
                            border: "none !important",
                            outline: 'none !important',
                        }
                    }
                },
                '& .btn-submit-olly': {
                    backgroundColor: '#9747FF',
                    height: '48px',
                    width: '48px',
                    padding: '12px',
                    borderRadius: '24px',
                    color: '#fff'
                }
            }}
            onClick={handleBoxClick}>
            <Input
                name="chat_entry"
                label=""
                type="text"
                placeholder="Ask queries related to BuildPiper"
                data={state.data}
                error={state.error}
                inputRef={inputRef}
                onKeyDown={handleKeyDown}
                onChangeHandler={commonFunction.onChangeHandler}
            />
            <button className='btn btn-submit-olly' onClick={send}>
                <i className='ri-arrow-up-line font-24'></i>
            </button>
        </Box>
    )
}

export default InputBubble



