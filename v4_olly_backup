                        jsonCompatible = jsonCompatible.replace(/\['/g, '["');   // After opening bracket
                        jsonCompatible = jsonCompatible.replace(/'\]/g, '"]');   // Before closing bracket
                        
                        // Step 3: Replace Python boolean/null values
                        jsonCompatible = jsonCompatible.replace(/None/g, 'null');
                        jsonCompatible = jsonCompatible.replace(/True/g, 'true');
                        jsonCompatible = jsonCompatible.replace(/False/g, 'false');
                        
                        // Step 4: Restore escaped quotes
                        jsonCompatible = jsonCompatible.replace(/___ESCAPED_SINGLE_QUOTE___/g, "'");
                        jsonCompatible = jsonCompatible.replace(/___ESCAPED_DOUBLE_QUOTE___/g, '\\"');
                        
                        try {
                            parsed = JSON.parse(jsonCompatible);
                            console.log("✓ Python dict conversion succeeded");
                        } catch (pythonError) {
                            console.error("✗ Enhanced conversion also failed:", pythonError.message);
                            throw pythonError;
                        }
                    }

                    // Extract response with multiple fallbacks
                    if (parsed && typeof parsed === 'object') {
                        console.log("Parsed object keys:", Object.keys(parsed));
                        
                        let extractedText = null;
                        
                        // Priority 1: execution_results
                        if (parsed.execution_results && typeof parsed.execution_results === 'string') {
                            extractedText = parsed.execution_results;
                            console.log("✓ Using execution_results");
                        }
                        // Priority 2: final_response (skip generic responses)
                        else if (parsed.final_response && typeof parsed.final_response === 'string') {
                            if (!parsed.final_response.includes("Okay, I understand") && 
                                !parsed.final_response.includes("I am ready to finalize")) {
                                extractedText = parsed.final_response;
                                console.log("✓ Using final_response");
                            } else if (parsed.execution_results) {
                                extractedText = parsed.execution_results;
                                console.log("✓ Using execution_results (final_response was generic)");
                            } else {
                                extractedText = parsed.final_response;
                                console.log("⚠ Using generic final_response");
                            }
                        }
                        // Priority 3: response field
                        else if (parsed.response && typeof parsed.response === 'string') {
                            extractedText = parsed.response;
                            console.log("✓ Using response");
                        }
                        // Last resort
                        else {
                            extractedText = text;
                            console.log("⚠ No suitable field found");
                        }

                        // Clean up the extracted text
                        if (typeof extractedText === 'string') {
                            // Unescape characters
                            extractedText = extractedText
                                .replace(/\\n/g, '\n')
                                .replace(/\\t/g, '\t')
                                .replace(/\\"/g, '"')
                                .replace(/\\'/g, "'");
                            
                            // Remove leading markdown headers
                            extractedText = extractedText.replace(/^##\s+/, '');
                            
                            text = extractedText;
                            console.log("✓ Final text (first 100 chars):", text.substring(0, 100));
                        }
                    }

                } catch (parseErr) {
                    console.error("=== PARSE ERROR ===");
                    console.error("Error:", parseErr.message);
                    console.error("Text sample:", text.substring(0, 300));
                    
                    // Manual regex extraction as last resort
                    // Try to extract execution_results or final_response
                    const execMatch = text.match(/'execution_results':\s*['"]([\s\S]*?)['"]\s*,\s*'final_response'/);
                    const finalMatch = text.match(/'final_response':\s*['"]([\s\S]*?)['"]\s*,\s*'status'/);
                    
                    if (execMatch && execMatch[1]) {
                        text = execMatch[1]
                            .replace(/\\n/g, '\n')
                            .replace(/\\t/g, '\t')
                            .replace(/\\"/g, '"')
                            .replace(/\\'/g, "'");
                        console.log("✓ Extracted via regex (execution_results)");
                    } else if (finalMatch && finalMatch[1]) {
                        text = finalMatch[1]
                            .replace(/\\n/g, '\n')
                            .replace(/\\t/g, '\t')
                            .replace(/\\"/g, '"')
                            .replace(/\\'/g, "'");
                        console.log("✓ Extracted via regex (final_response)");
                    } else {
                        console.error("✗ All extraction methods failed");
                        text = 'Unable to parse response. Please check the console for details.';
                    }
                }
            }

            return {
                type: 'bot',
                text: typeof text === 'string' ? text : JSON.stringify(text, null, 2)
            };
        }

        // Fallback for other message formats
        const text =
            item.content ??
            item.text ??
            item.message ??
            item.body ??
            (typeof item === 'object' ? JSON.stringify(item, null, 2) : String(item));

        const sender = (item.role ?? item.sender ?? '').toString().toLowerCase();
        const isUser = sender === 'user' || sender === 'human';

        return { type: isUser ? 'user' : 'bot', text };
    } catch (e) {
        console.error('normalizeHistoryItem outer error:', e);
        return { type: 'bot', text: 'Error processing message' };
    }
};





