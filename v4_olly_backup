  function validateAndSave(text) {
    return new Promise((resolve) => {
        const post_data = { message: text };

        // show loading spinner for this conversation call
        setState(prev => ({ ...prev, show_loading_icon: true }));

        // Helper to extract error message from various response formats
        const getErrorMessage = (err) => {
            // Check for different error response formats
            if (err && typeof err === 'object') {
                // Format 1: { response: "error message" }
                if (err.response && typeof err.response === 'string') {
                    return err.response;
                }
                // Format 2: { response: { response: "error message" } }
                if (err.response && err.response.response && typeof err.response.response === 'string') {
                    return err.response.response;
                }
                // Format 3: { error: "error message" }
                if (err.error && typeof err.error === 'string') {
                    return err.error;
                }
                // Format 4: { message: "error message" }
                if (err.message && typeof err.message === 'string') {
                    return err.message;
                }
                // Format 5: { data: { response: "error message" } }
                if (err.data && err.data.response && typeof err.data.response === 'string') {
                    return err.data.response;
                }
            }
            // If it's a string, return it directly
            if (typeof err === 'string') {
                return err;
            }
            // Default fallback
            return 'Server is currently unavailable. Please try again later.';
        };

        // Helper to normalize payload -> string
        const normalizePayloadToString = (res) => {
            try {
                const payload = res?.response?.final_response;
                if (payload == null) return 'No response';
                if (typeof payload === 'string') return payload;
                if (typeof payload !== 'object') return String(payload);
                const maybe = payload.reply ?? payload.message ?? payload.text;
                if (maybe != null) return typeof maybe === 'string' ? maybe : JSON.stringify(maybe, null, 2);
                if (Array.isArray(payload.candidates) && payload.candidates.length) {
                    const parts = [];
                    for (const c of payload.candidates) {
                        if (Array.isArray(c.content)) {
                            for (const p of c.content) {
                                if (typeof p === 'string') parts.push(p);
                                else if (p && typeof p.text === 'string') parts.push(p.text);
                                else parts.push(JSON.stringify(p));
                            }
                        } else if (typeof c === 'string') parts.push(c);
                        else parts.push(JSON.stringify(c));
                    }
                    const joined = parts.join('\n\n').trim();
                    if (joined) return joined;
                }
                if (Array.isArray(payload.outputs) && payload.outputs.length) {
                    return payload.outputs.map(o => (o.content ?? o.text ?? JSON.stringify(o))).join('\n\n');
                }
                return JSON.stringify(payload, null, 2);
            } catch (e) {
                console.error('normalize error', e);
                return 'No response';
            }
        };

        // Build URL for continue endpoint (if conversation exists) or start endpoint
        const callContinue = (conversationId, message, done) => {
            const continueUrl = GenerateURL({ conversation_id: conversationId }, properties.api.bp_olly_agent.continue_convo);
            PostData(
                continueUrl,
                { message },
                (resContinue) => {
                    console.log(resContinue, "fkjdfsjkakfsajdfjsa")
                    try { saveSuccess(resContinue); } catch (_) { /* ignore */ }
                    // hide loading now that we have a response
                    setState(prev => ({ ...prev, show_loading_icon: false }));

                    const reply = normalizePayloadToString(resContinue);
                    return done(reply);
                },
                (errContinue) => {
                    console.error("Continue conversation error:", errContinue);
                    setState(prev => ({ ...prev, show_loading_icon: false }));
                    try { saveFail(errContinue); } catch (_) { /* ignore */ }
                    
                    // Use the new error message extractor
                    const msg = getErrorMessage(errContinue);
                    return done(msg);
                },
                true,
                true
            );
        };

        // If conversation already exists, post directly to continue_convo
        if (state?.conversation_id) {
            callContinue(state.conversation_id, text, (reply) => resolve(reply));
            return;
        }

        // No conversation yet: call start_convo to create conversation_id
        const startUrl = GenerateURL({}, properties.api.bp_olly_agent.start_convo);
        PostData(
            startUrl,
            post_data,
            (resStart) => {
                try { saveSuccess(resStart); } catch (_) { /* ignore */ }

                const payloadStart = resStart?.data ?? resStart;
                const convId = payloadStart?.conversation_id ?? payloadStart?.conversation?.id ?? payloadStart?.id;

                if (convId) {
                    // update component state conversation_id and continue endpoint url
                    try {
                        const convoApiUrl = GenerateURL({ conversation_id: convId }, properties.api.bp_olly_agent.continue_convo);
                        setState(prev => ({
                            ...prev,
                            conversation_id: convId,
                            conversation_api_url: convoApiUrl,
                            newConversationId: convId
                        }));

                        // Set selected conversation for highlighting
                        setSelectedConversation({ conversation_id: convId });

                    } catch (sErr) {
                        console.error('Failed to set conversation state', sErr);
                    }

                    // update browser path to /bp-olly/<id> without reload
                    try {
                        if (typeof window !== 'undefined') {
                            const clientPath = `/bp-olly/${convId}`;
                            const urlObj = new URL(window.location.href);
                            urlObj.pathname = clientPath;
                            urlObj.searchParams.delete('message');
                            window.history.replaceState({}, document.title, urlObj.toString());
                        }
                    } catch (urlErr) {
                        console.error('Failed to update conversation URL', urlErr);
                    }

                  
                    // Now post the original message to continue_convo and resolve with that reply
                    callContinue(convId, text, (reply) => resolve(reply));
                } else {
                    // hide loading if no conv id returned and we are resolving fallback
                    setState(prev => ({ ...prev, show_loading_icon: false }));
                    // If no convId returned, normalize and resolve with start response (fallback)
                    const fallback = normalizePayloadToString(resStart);
                    return resolve(fallback);
                }
            },
            (errStart) => {
                console.error("Start conversation error:", errStart);
                setState(prev => ({ ...prev, show_loading_icon: false }));
                try { saveFail(errStart); } catch (_) { /* ignore */ }
                
                // Use the new error message extractor
                const msg = getErrorMessage(errStart);
                return resolve(msg);
            },
            true,
            true
        );

    });
}


