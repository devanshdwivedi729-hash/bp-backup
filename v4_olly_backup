                            scrollbarWidth: 'thin',
                            scrollbarColor: 'transparent transparent',
                            '&:hover': {
                                scrollbarColor: '#d3d3d3 transparent'
                            }
                        }}
                    >
                      
                        {messages.length === 0 && (
                            <FirstTimeConvo />
                        )}

                        {messages.map((m, i) => (
                            <div 
                            key={i} 
                            className={m.type === 'bot' ? 'bot-message' : 'user-message'}
                            style={{ display: 'flex', justifyContent: m.type === 'user' ? 'flex-end' : 'flex-start', marginBottom: 10 }}>
                                <div style={{
                                    background: m.type === 'user' ? '#e0f7fa' : '#fff',
                                    color: m.type === 'user' ? '#222' : '#333',
                                    borderRadius: 8,
                                    padding: '8px 12px',
                                    maxWidth: '75%',
                                    boxShadow: '0 1px 2px rgba(0,0,0,0.04)',
                                    scrollMarginTop: '80px' 
                                }}>
                                    <ResponseRenderer content={m.text} isLoading={!!m.isLoading && !m.isConversationLoading} isConversationLoading={!!m.isConversationLoading} userQuery={m.userQuery || ''} />
                                </div>
                            </div>
                        ))}
                    </Box>
                </Box>
                <div className="footer">
                    <InputBubble onSend={handleSend} />
                </div>
            </Box>
        </div>
    );
};

export default FullScreenModeOllyCopilot;



