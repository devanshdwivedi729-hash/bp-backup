const VMSetHealthDialog = ({ isActive, ...props }) => {
    const classes = useStyles();
    const id = props.id ? props.id : null;
    console.log(id, "fdskjjfsa")
    const [state, setState] = useState({
        open: false,
        data_loading: false
    })

const SkeletonRow = () => {
  return (
    <div style={{ display: "flex", flexDirection: "column", alignItems: "center", width: "100%" }}>
      <div style={{ display: "flex", gap: "12px", justifyContent: "center", alignItems: "center", marginBottom: "16px" }}>
        <GenericSkeleton
          variant="rect"
          width="154px"
          height="154px"
          style={{ borderRadius: "999px" }}
        />
        <GenericSkeleton
          variant="rect"
          width="154px"
          height="154px"
          style={{ borderRadius: "999px" }}
        />
      </div>
      <div style={{ width: "60%", marginBottom: "16px" }}>
        <GenericSkeleton
          variant="rect"
          width="100%"
          height="60px"
          style={{ borderRadius: "4px" }}
        />
      </div>
      <div style={{ width: "100%" }}>
        <GenericSkeleton
          variant="rect"
          width="100%"
          height="70px"
          style={{ borderRadius: "4px" }}
        />
      </div>
    </div>
  );
};
    function fetchMasterEnvList(id) {
        var requestInfo = {
            endPoint: GenerateURL({},
                properties.api.vm_health_check + "?vm_id=" + id
            ),
            httpMethod: "GET",
            httpHeaders: { "Content-Type": "application/json" },
        };
        InvokeApi(
            requestInfo,
            fetchMasterEnvListDataSuccess,
            fetchMasterEnvListDataFailed
        );

        setState((new_state) => ({
            ...new_state,
            data_loading: true,
        }));
    }


    const transformData = (data) => {
        const percentage = ((data.cpu_utilization / data.cpu_freq) * 100).toFixed(2);
        const ram_percentage = ((data.ram_utilization / data.allocated_ram_gb) * 100).toFixed(2);
        let arr = [
            {
                label: "CPU",
                percentage: percentage,
                color: "green",
                allocatedLabel: "Avg Utilization/Cores",
                allocatedValue: data.cpu_utilization + "/" + data.cpu_freq,
            },
            {
                label: "RAM",
                percentage: ram_percentage,
                color: "red",
                allocatedLabel: "Utilized/Allocated",
                allocatedValue: data.ram_utilization + "/" + data.allocated_ram_gb,
            }
        ]
        return arr
    }

    // normal warning danger

    const compareDataAndShowStats = (utilization, allocated) => {
        const utilizationPercentage = (utilization / allocated) * 100;

        if (utilizationPercentage < 30) {
            return 'normal';
        } else if (utilizationPercentage <= 60) {
            return 'warning';
        } else {
            return 'danger';
        }
    };
    const compareDataAndShowStatsCPU = (utilizationPercentage) => {


        if (utilizationPercentage < 30) {
            return 'normal';
        } else if (utilizationPercentage <= 60) {
            return 'warning';
        } else {
            return 'danger';
        }
    };

    function fetchMasterEnvListDataSuccess(data) {
        console.log(data, "fsjkjksd")
        setState((new_state) => ({
            ...new_state,
            data_loading: false,
            data: data,
            cpu_data: {
                percentage: data.avg_cpu_utilization,
                allocatedValue: data.avg_cpu_utilization + "/" + data["Core(s) per socket"] && data["Core(s) per socket"],
                allocatedLabel: '',
                status: compareDataAndShowStatsCPU(data.avg_cpu_utilization),
                utilization: data.avg_cpu_utilization + "%",
                allocated: "",
                meter_label: 'CPU',
                label: "Avg Utilization"
            },
            ram_data: {

                percentage: data.ram_utilization,
                allocatedValue: data.ram_used_in_gb + "/" + data.ram_allocated_in_gb,
                utilization: data.ram_used_in_gb + " GB",
                allocated: data.ram_allocated_in_gb + " GB",
                meter_label: 'RAM',
                allocatedLabel: '',
                label: null,
                status: compareDataAndShowStats(data.ram_used_in_gb, data.ram_allocated_in_gb),
            }

        }));
    }
    function fetchMasterEnvListDataFailed(error) {
        console.log(error, "error_msgerror_msg")
        const error_msg = error.detail
        setState((new_state) => ({
            ...new_state,
            error: error_msg,
            data_loading: false,
        }));
    }

    const handleClickOpen = () => {
        if (id) {
            fetchMasterEnvList(id)
        }

        setState(prev_state => ({
            ...prev_state,
            open: true
        }))
    }

    const handleClose = () => {
        setState(prev_state => ({
            ...prev_state,
            open: false
        }))
    }


    return (
        <>
            <button style={{ cursor: isActive ? 'pointer' : 'not-allowed' }} className="btn btn-transparent" onClick={isActive ? handleClickOpen : null} >
                <span className='ri-heart-pulse-line font-18' style={{ color: isActive ? '#124D9B' : '#808080c4' }}></span>
            </button>
            <Dialog
                fullWidth={true}
                maxWidth={'md'}
                open={state.open}
                onClose={handleClose}
                className={`${classes.root} dialog-align-corner`}
                aria-labelledby="max-width-dialog-title"
            >
                <div className='d-grid ml-auto dialog-sub-component' style={{ gridTemplateColumns: '650px' }}>
                    <div className='right-panel-dialog bg-white'>
                        <div className='font-18 font-weight-600 color-white d-flex align-center space-between' style={{ backgroundColor: '#0086ff', padding: '13.5px 20px' }}>
                            <p>Service Health</p>
                            <button
                                className='btn float-cancel-button'
                                style={{ left: '296px' }}
                                onClick={handleClose}
                            >
                                <span className='ri-close-line'></span>
                            </button>
                        </div>
                        <div className='' style={{ padding: '16px' }}>
                            {
                                state.data_loading ? <SkeletonRow />
                                    :
                                    state.error ?
                                        <p className='error-msg'>
                                            {state.error}
                                        </p>
                                        :
                                        <>
                                            <div className='d-flex align-center m-auto space-between' style={{ width: '50%' }}>
                                                <HealthStatusRoundMeter data={[state.cpu_data]} useNewMeter={true} />
                                                <HealthStatusRoundMeter data={[state.ram_data]} useNewMeter={true} />
                                            </div>
                                            <div className='mb-16' style={{ border: '1px solid #E6E6E6', borderRadius: '4px', padding: '10px' }}>
                                                <p className='color-tertiary mb-5 font-14'>CPU SPECS</p>
                                                <p className='color-primary mb-5 font-14'>

                                                    {state.data && state.data["Core(s) per socket"] ? state.data["Core(s) per socket"] : "N/A"} Cores, {state.data && state.data["Thread(s) per core"] ? state.data["Thread(s) per core"] : "N/A"}
                                                    {state.data && state.data["Thread(s) per core"] ? state.data["Thread(s) per core"] == 1 ? " Thread Per Core" : " Threads Per Core" : null}
                                                    {/* &nbsp;{state.data && state.data["cpu_speed"] ? state.data.cpu_speed.toFixed(2) + " MHz" : "N/A"} CPU Speed */}
                                                </p>
                                            </div>
                                            {/* <div className='mb-16' style={{ border: '1px solid #E6E6E6', borderRadius: '4px', padding: '10px' }}>
                                                <p className='color-tertiary mb-5 font-14'>MEMORY SPECS</p>
                                                <p className='color-primary mb-5 font-14'>
                                                   
                                                Used Ram: {state?.data?.ram_used_in_gb} GB, Allocated Ram: {state?.data?.ram_allocated_in_gb} GB
                                                </p>
                                            </div> */}
                                            <div className={classes.rooter} style={{ border: '1px solid #E6E6E6', borderRadius: '4px', padding: '10px' }}>
                                                <p className='color-tertiary mb-5 font-14'>STORAGE</p>
                                                <div className='d-flex align-center space-between'>
                                                    <p className='font-12 color-primary'>{
                                                        (state.data && state.data.total_disk_storage ?
                                                            state.data.total_disk_storage.total_used_gb ?
                                                                state.data.total_disk_storage.total_used_gb.toFixed(2) : "N/A" : "N/A")} / {
                                                            (
                                                                state.data && state.data.total_disk_storage ?
                                                                    state.data.total_disk_storage.total_size_gb ?
                                                                        state.data.total_disk_storage.total_size_gb.toFixed(2) : "N/A" : "N/A"
                                                            )} GB</p>
                                                    <p className='font-12 color-tertiary'>{(state?.data?.total_disk_storage?.total_size_gb - state?.data?.total_disk_storage?.total_used_gb).toFixed(2)} GB available</p>
                                                </div>
                                                <BorderLinearProgress variant="determinate"
                                                    value={((state?.data?.total_disk_storage?.total_used_gb / state?.data?.total_disk_storage?.total_size_gb) * 100).toFixed(2)} />
                                            </div>
                                        </>
                            }

                            <div>

                            </div>
                        </div>
                    </div>
                </div>
            </Dialog>

        </>
    )
}

